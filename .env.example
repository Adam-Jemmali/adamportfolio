# ── The Build Log newsletter (madajbuilds) ──────────────────────────
# The signup form posts { "email": "..." } to /api/subscribe, a Vercel
# serverless function. That function talks to Resend. The API key must
# stay server side, so these are set in the Vercel dashboard
# (Project > Settings > Environment Variables), NOT shipped to the client.
#
# For local testing run `npx vercel dev` and put the values in .env
# (which is gitignored).

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Resend Topic id the signups get opted into — Audience > Topics > (open) > </>
RESEND_TOPIC_ID=

# Verified sender, e.g. "The Build Log <log@mail.adamjemmali.me>"
# (the domain — mail.adamjemmali.me — must be verified in Resend first)
NEWSLETTER_FROM=

# Where quiz completion pings and any owner notices go
OWNER_EMAIL=

# ── OS site "Join the Forge" form (src/window/Safari.jsx) ────────────
# Unrelated to the above. Point this at Formspree / your own endpoint.
VITE_NEWSLETTER_ENDPOINT=
